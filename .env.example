# Copy this file to .env and fill in real values before running the app.

# Used to sign sessions/flash messages and as the source key for encrypting
# authorization documents and credentials at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-value

# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///./data/app.db

# Directory where uploaded Tier 2 authorization documents are stored (encrypted)
AUTH_DOCS_DIR=./data/authorizations

# Directory where uploaded dependency manifests are stored temporarily
UPLOADS_DIR=./data/uploads

# Who is running scans from this instance (recorded in the audit log / attestations)
OPERATOR_NAME=Brian

# Days to retain scan results/findings before they are eligible for purge.
# 0 = keep forever.
RETENTION_DAYS=0

# Base URL the app is served from (used to build verification instructions)
APP_BASE_URL=http://localhost:8000
